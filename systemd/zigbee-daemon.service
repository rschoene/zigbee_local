[Unit]
Description=Zigbee Daemon (zigpy-based Zigbee coordinator)
After=network.target
# If the dongle is missing, the daemon exits(1) and systemd retries.
# After 5 failures within 60 s, systemd gives up and marks the service
# as failed. Re-plug the dongle and run: systemctl start zigbee-daemon
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=zigbee
WorkingDirectory=/opt/zigbee_local
ExecStart=/opt/zigbee_local/.venv/bin/python -m daemon -c /opt/zigbee_local/config.yaml
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zigbee_local/data

[Install]
WantedBy=multi-user.target
